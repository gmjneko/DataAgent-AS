# Data Agent 环境变量配置
# 此文件不应提交到 Git（已在 .gitignore 中）

# AI 模型配置 (必填)
IO_GITHUB_MALONETALK_MODEL_API_KEY=
IO_GITHUB_MALONETALK_MODEL_PROVIDER=openai
IO_GITHUB_MALONETALK_MODEL_NAME=deepseek-v4-flash
IO_GITHUB_MALONETALK_MODEL_BASE_URL=https://api.deepseek.com
IO_GITHUB_MALONETALK_MODEL_THINKING_ENABLED=true

# 数据库配置
DB_PASSWORD=root

# JWT 配置（生产环境必须 >= 32 字节）
JWT_SECRET=

# 管理员配置（首次启动时使用）
ADMIN_INIT_PASSWORD=admin

# AgentScope 2.x workspace is persisted by docker-compose.
AGENTSCOPE_STATE_TABLE=agentscope_agent_state
AGENTSCOPE_TRIGGER_MESSAGES=30
AGENTSCOPE_KEEP_MESSAGES=10
AGENTSCOPE_TRIGGER_TOKENS=32000
AGENTSCOPE_MAX_TOOL_RESULT_CHARS=80000
AGENTSCOPE_MCP_ENABLED=true

# Self-hosted E2B. Replace the placeholder address before running execute_python.
E2B_API_BASE_URL=http://e2b.example.local
E2B_DOMAIN=e2b.example.local
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_SANDBOX_TIMEOUT_SECONDS=300
